# Forward secure sealing of the journal. The keys are generated by the
# installer, see lib/default.nix.
{ lib, ... }: {
  # Persistent storage and sealing are already the defaults, the option only
  # tells the installer to generate the keys.
  options.securix.journaldFSS = {
    enable = lib.mkEnableOption "forward secure sealing of the system journal";
  };
}
